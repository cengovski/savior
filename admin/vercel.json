{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/panel.js": {
      "includeFiles": "{protected/**,../admin/protected/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/panel"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/logout",
      "destination": "/api/logout"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
