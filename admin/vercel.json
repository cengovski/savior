{
  "cleanUrls": true,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/panel"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/panel.js": {
      "includeFiles": "protected/**"
    }
  }
}
